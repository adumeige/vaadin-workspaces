<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.adumeige.vaadin-workspaces</groupId>
    <artifactId>vaadin-workspaces</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Vaadin Workspaces Parent</name>
    <description>Workspace components, annotation layers and Karibu DSL builders for Vaadin Flow.</description>

    <url>https://github.com/adumeige/vaadin-workspaces</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>adumeige</id>
            <name>Antoine Dumeige</name>
            <url>https://github.com/adumeige</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/adumeige/vaadin-workspaces.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/adumeige/vaadin-workspaces.git</developerConnection>
        <url>https://github.com/adumeige/vaadin-workspaces</url>
    </scm>

    <modules>
        <module>workspace-component</module>
        <module>workspace-doodles</module>
        <module>workspace-component-karibu</module>
        <module>workspace-doodles-karibu</module>
        <module>workspace-demo</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <!-- Karibu 2.6+ requires Java 21 / Vaadin 25. -->
        <karibu.version>2.5.0</karibu.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <central.autoPublish>false</central.autoPublish>
        <central.skipUpload>false</central.skipUpload>
        <central.waitUntil>validated</central.waitUntil>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <vaadin.version>24.10.0</vaadin.version>
        <spring-boot.version>3.5.11</spring-boot.version>
    </properties>

    <repositories>
        <repository>
            <id>mavenCentral</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <id>vaadin-addons</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mavenCentral</id>
            <url>https://repo1.maven.org/maven2/</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <signer>bc</signer>
                            <bestPractices>true</bestPractices>
                            <keyEnvName>MAVEN_GPG_KEY</keyEnvName>
                            <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <skipUpload>${central.skipUpload}</skipUpload>
                            <waitUntil>${central.waitUntil}</waitUntil>
                            <waitMaxTime>3600</waitMaxTime>
                            <deploymentName>${project.groupId}:${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

